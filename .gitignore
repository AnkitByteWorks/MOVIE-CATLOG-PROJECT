# ====================================================================
# CinePulse / Movie Tracker — Root Monorepo .gitignore
# ====================================================================

# Environment Variables & Secrets
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Java / Maven Build Artifacts
backend/**/target/
target/
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Node / Next.js Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
node_modules/
.next/
out/
build/
dist/
coverage/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.vercel
*.tsbuildinfo

# IDE & Editor Settings
**/.idea/
**/*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
.apt_generated
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# OS Specific
.DS_Store
Thumbs.db

# Logs & Dumps
*.log
logs/
heapdump.hprof
replay_pid*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Scratch & Backups
scratch/
*.tmp
*.bak
*.lock
